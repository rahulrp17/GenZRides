# Copy to .env / .env.production and fill in values.
# Public API base (frontend build bakes these in at build time).
VITE_API_URL=http://localhost:5000/api

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Empty = analytics disabled. CookieBanner gates loading on visitor consent.
VITE_GA_MEASUREMENT_ID=
