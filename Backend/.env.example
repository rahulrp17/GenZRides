PORT=5000
NODE_ENV=development

# MongoDB connection string (production should use a replica set for transactions)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/lets-go-cab?retryWrites=true

# JWT (use strong, unique, >=32 char secrets in production)
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-min-32-chars
JWT_REFRESH_EXPIRES=30d

# Frontend origin allowed by CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Google Maps / Routes API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# WhatsApp Cloud API (admin booking alerts; backend only, never frontend)
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_NUMBER=your-admin-whatsapp-number
# Approved template for business-initiated alerts (must match dashboard exactly)
WHATSAPP_TEMPLATE_NAME=new_booking_alert
WHATSAPP_TEMPLATE_LANG=en

# Cloudinary (document/image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Redis (rate limiting, Socket.IO adapter, webhook idempotency)
# Leave REDIS_HOST empty to run single-instance with in-memory fallbacks.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" if your Redis requires a TLS connection (e.g. managed cloud)
REDIS_TLS=false

# Web Push (browser push notifications; backend only, never frontend)
# Generate with: npx web-push generate-vapid-keys
# Leave empty to disable browser push (Socket.IO + in-app notifications keep working).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@genzrides.com

# Admin booking alert emails (SMTP; backend only, never frontend)
# Leave empty to disable booking emails (WhatsApp + in-app alerts keep working).
# On Render/Railway/Vercel free, outbound SMTP 587/465 is often blocked
# (ENETUNREACH/Connection timeout). Prefer HTTPS API (443) — set RESEND_API_KEY
# or BREVO_API_KEY and SMTP will be bypassed. See email.service.js:295.
# RESEND_API_KEY=re_xxx  # https://resend.com/api-keys (sends via HTTPS)
# BREVO_API_KEY=xkeysib-xxx  # https://app.brevo.com/settings/keys/api
SMTP_HOST=
SMTP_PORT=587
# Set to "true" for port 465 (implicit TLS)
SMTP_SECURE=false
# Force IPv4 to avoid ENETUNREACH on hosts with no IPv6 egress (default 4)
# SMTP_FAMILY=4
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
# Shown as the sender; a single EMAIL_FROM wins, otherwise
# EMAIL_FROM_NAME + EMAIL_FROM_ADDRESS are combined, otherwise
# GenZRides <no-reply@genzrides.com> is used.
# For Resend: domain must be verified at https://resend.com/domains
# Use onboarding@resend.dev for testing, or verify your domain.
EMAIL_FROM=
# EMAIL_FROM_NAME=GenZRides
# EMAIL_FROM_ADDRESS=you@gmail.com
# RESEND_FROM=GenZRides <onboarding@resend.dev>  # overrides EMAIL_FROM for Resend only

# Public frontend URL for inbox deep links (View booking button).
# Falls back to CLIENT_URL; the button is omitted when neither is set.
# FRONTEND_URL=https://app.genzrides.com

# OpenRouter AI (for the AI assistant chat)
OPENROUTER_API_KEY=your-openrouter-api-key-here
